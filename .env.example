# Copy to .env and fill in. .env is gitignored, this template is tracked.

# --- VLM (Phase 1 ingestion) ---
VLM_URL=
VLM_API_KEY=
# Opt-in workaround for VLMs with parallel-request problems (e.g. llama.cpp #17200).
VLM_SERIALIZE_REQUESTS=false
# Delay after each VLM response, ms. Only applies when VLM_SERIALIZE_REQUESTS=true.
VLM_REQUEST_DELAY_MS=0
# Sampling temperature for VLM tagging responses. Default 0.4 ensures retries
# produce genuinely independent samples (06-decisions.md).
VLM_TEMPERATURE=0.4

# --- LLM (no consumer until Phase 3 recommender) ---
LLM_URL=
LLM_API_KEY=
