# --- Runtime data (personal, never committed) ---
data/
logs/
temp/

# --- Secrets / local config ---
.env
.env.*
!.env.example

# --- Go ---
/wardrobe
/server
*.exe
*.test
*.out
vendor/

server
ingest

# --- Frontend (Vite/React) ---
frontend/node_modules/
frontend/dist/*
# Keep the placeholder tracked so go:embed always has a match on a fresh
# checkout; a real `npm run build` replaces it locally (ING-021).
!frontend/dist/index.html
frontend/.vite/
frontend/*.local

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
